# WifiSync's own configuration (no managed network/wireless settings)
#
# Important: this file only describes "what WifiSync itself wants to do".
#   * Gateway role: only records the user-selected LAN interfaces, never modifies the network
#   * Controller role: only handles new AP admission and network info distribution, never modifies the local network
#   * AP role: the only role that applies the distributed Wi-Fi / bridge info (and only when admitted)

config wifisync 'main'
	# Tracks whether the user explicitly set the roles. When 0, the first start picks defaults from hardware capability:
	# has wireless => "controller ap gateway"; no wireless => "controller gateway" (AP dropped automatically)
	option roles_configured '0'
	option roles 'controller ap gateway'
	option device_id ''
	option bridge_name 'br-lan'
	# managed_only: restore only keys changed by WifiSync; full: overwrite everything from the baseline
	option restore_mode 'managed_only'
	# AP sync mode: auto (follow the Controller) / local_override (temporary local override)
	option sync_mode 'auto'
	option local_wifi_change_confirmed '0'
	# Gateway role only: user-selected LAN interfaces (identification and probing only)
	list gateway_lan_ifaces ''
	# Connectivity probe targets (the program only probes; it never changes routes/NAT/firewall)
	option gateway_endpoint ''
	option controller_endpoint ''

# Wi-Fi info source: controller_self (the controller itself) / gateway (read-only pull from the gateway) / custom
config wifi_source 'source'
	option kind 'controller_self'
	option gateway_endpoint ''
	option gateway_credential_ref ''
	option allow_fallback '0'

# Only takes effect when kind='custom'.
# Note: if this device also acts as an AP (AP and Controller on the same device),
# applying custom info modifies the local wireless config and requires explicit user confirmation (local_wifi_change_confirmed=1).
config custom_wifi 'custom'
	option ssid 'WifiSync'
	option auth 'sae-mixed'
	option psk_ref 'custom'
	option band '5g'
	option channel ''
	option hidden '0'
	option mobility_domain '1a2b'
	option ieee80211k '1'
	option ieee80211v '1'
	option ieee80211r '1'
	option ft_over_ds '1'
	option ft_psk_generate_local '1'

# Optional: restore the device's default network when the Controller / Gateway is unreachable (off by default)
config failsafe 'failsafe'
	option enabled '0'
	option apply_confirm_secs '90'
	option link_timeout_secs '300'
	option action 'revert'
	option keep_ssid '0'
	option heartbeat_endpoint ''
