#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# WifiSync service script
#
# Lifecycle discipline (requirement 11):
#   * start: the daemon creates/verifies the initial baseline itself before working (it refuses to start without a baseline)
#   * stop: the daemon restores the original network synchronously on SIGTERM; this script then runs one more idempotent restore,
#           to avoid an incomplete restore when procd sends SIGKILL first.

START=99
STOP=01
USE_PROCD=1

PROG=/usr/bin/wifisync
NO_RESTORE_FLAG=/etc/wifisync/no-restore-on-stop

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/wifisync
	procd_set_param limits nofile="1024 1024"
	procd_close_instance
}

stop_service() {
	# Fallback restore: idempotent, no duplicate changes even if a restore already happened
	[ -x "$PROG" ] || return 0
	if [ -f "$NO_RESTORE_FLAG" ]; then
		logger -t wifisync "found $NO_RESTORE_FLAG, skipping the pre-stop restore"
		return 0
	fi
	"$PROG" restore >/dev/null 2>&1 || \
		logger -t wifisync "pre-stop restore failed, check /etc/wifisync/backup/initial"
	return 0
}

service_triggers() {
	procd_add_reload_trigger wifisync
}
