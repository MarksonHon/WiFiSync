#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# rpcd exec plugin bridge: exposes the wifisync local UNIX socket interface as the ubus object `wifisync`.
#
# rpcd calling convention:
#   /usr/libexec/rpcd/wifisync list            → print the method table JSON
#   /usr/libexec/rpcd/wifisync call <method>   → read arguments from stdin, print the result to stdout

exec /usr/bin/wifisync ubus "$@"
