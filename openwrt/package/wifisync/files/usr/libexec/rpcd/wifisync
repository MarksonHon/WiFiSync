#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# rpcd exec 插件桥：把 wifisync 的本地 UNIX socket 接口暴露为 ubus 对象 `wifisync`。
#
# rpcd 的调用约定：
#   /usr/libexec/rpcd/wifisync list            → 打印方法表 JSON
#   /usr/libexec/rpcd/wifisync call <method>   → 从 stdin 读参数，向 stdout 打印结果

exec /usr/bin/wifisync ubus "$@"
